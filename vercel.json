{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build && cp -r frontend/dist ./dist",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/companies/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/companies",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|companies).*)",
      "destination": "/index.html"
    }
  ]
}
